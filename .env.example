# Web3Forms public client-side access key. This is intentionally NEXT_PUBLIC because
# Web3Forms free submissions are sent directly from the visitor's browser.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# Private server-side Upstash credentials. Never use NEXT_PUBLIC_ for these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Private random 32+ character secret used only to hash contact/IP identifiers before Redis storage.
PROJECT_REQUEST_HASH_SECRET=""

# Optional booking override. The site already falls back to your Cal.com 30-minute event.
# NEXT_PUBLIC_BOOKING_URL="https://cal.com/raed-xyyqgc/30min"

# Private portfolio dashboard login. Keep both server-side only in Netlify.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# GitHub-backed CMS. Create a fine-grained token with Contents: Read and write
# access to only the newest-portfolio repository. Never use NEXT_PUBLIC_ here.
GITHUB_CMS_TOKEN=""
GITHUB_CMS_OWNER="raedmasri11"
GITHUB_CMS_REPO="newest-portfolio"
GITHUB_CMS_BRANCH="main"
